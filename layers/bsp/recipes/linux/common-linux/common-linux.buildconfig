: ${config_bsp__console_device=""}
export config_bsp__console_device

#
# The function sets CONSOLE_DEV_TTY to the most likely interface.
# AS this is expected to be sourced very early in the build, and called during build distro,
# a more specific BSP can override this function
#
bsp_linux__set_console_device_by_target_architecture() {
	if [ -n "$config_bsp__console_device" ] ; then
		CONSOLE_DEV_TTY=$config_bsp__console_device
		return
	fi

	case $ARCH in
		arm*|aarch64)
			: ${CONSOLE_DEV_TTY=ttyAMA0}
			;;
		x86*|i*86)
			: ${CONSOLE_DEV_TTY=ttyS0}
			;;
		riscv*)
			: ${CONSOLE_DEV_TTY=ttyS0}
			;;
		*)
			warn "Please be more specific if you add target architecture. Will assume that the console is ttyS0 - however, you may want to double check it with, e.g. your device tree"
			: ${CONSOLE_DEV_TTY=ttyS0}
			;;
	esac
	export CONSOLE_DEV_TTY
}
export -f bsp_linux__set_console_device_by_target_architecture