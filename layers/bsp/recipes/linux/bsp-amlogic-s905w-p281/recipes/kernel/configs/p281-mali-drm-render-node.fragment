#
# While they are modules in a default configuration, it is useful, to avoid handpicking modules, to have them builtin
# this enables /dev/dri/renderD128 
# This also enables /dev/dri/card1
#
CONFIG_DRM_EXEC=y
CONFIG_DRM_GEM_SHMEM_HELPER=y
CONFIG_DRM_GPUVM=y
CONFIG_DRM_LIMA=y
CONFIG_DRM_PANFROST=y
CONFIG_DRM_PANTHOR=y
CONFIG_DRM_SCHED=y
